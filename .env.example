# Copy to .env.local for local dev. Never commit real values.

# --- Required (secret) -------------------------------------------------------
# Shared secret the ElevenLabs agent sends as X-DCP-Agent-Secret. Unset = every tool endpoint returns 503.
ELEVENLABS_WEBHOOK_SECRET=

# Persistent ticket store (Upstash Redis). Either pair works; the Vercel Marketplace integration sets KV_*.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Shopify, read-only ------------------------------------------------------
SHOPIFY_STORE_DOMAIN=            # public, e.g. your-store.myshopify.com
SHOPIFY_STOREFRONT_READONLY_TOKEN= # Storefront API token (read-only): search, availability, listed price
# Admin app with ONLY read_products scope, for the dcp.part_cost metafield (server-side only)
SHOPIFY_CLIENT_ID=               # secret
SHOPIFY_CLIENT_SECRET=           # secret
# SHOPIFY_ADMIN_API_VERSION=2026-01

# --- Notifications (secret) --------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=              # E.164, e.g. +15095551234
SLACK_ESCALATION_WEBHOOK_URL=    # https:// Slack incoming webhook for Tier 3 alerts
THERMAL_LOCKOUT_ALERT_PHONE=     # optional ops number for bench thermal alerts
